# Absolute origin of the deployment, no trailing slash.
# When empty: no canonical links, no absolute OG URLs, no sitemap, and crawlers
# are blocked — the build never falls back to localhost or a made-up domain.
SITE_URL=

# Flip to true only when SITE_URL points at a real, public storefront.
# A portfolio demo should leave this false so the site never competes in search.
SEO_INDEXING=false
